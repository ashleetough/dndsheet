  wrap.querySelectorAll('input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      const field=inp.dataset.f;
      state.inventory[inp.dataset.i][field]= field==='qty' ? (parseInt(inp.value)||0) : inp.value;
      scheduleSave();
    });
  });
  wrap.querySelectorAll('.li-del').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      state.inventory.splice(parseInt(btn.dataset.i),1);
      renderItems(); scheduleSave();
    });
  });
}

function renderClass(){
  const count=superiorityCount(state.level);
  const die=superiorityDie(state.level);
  document.getElementById('su-die').textContent = count>0 ? `(${count} × ${die})` : '(none yet — 3rd level)';
  const dotsWrap=document.getElementById('su-dots');
  dotsWrap.innerHTML='';
  for(let i=0;i<count;i++){
    const d=document.createElement('div');
    d.className='su-dot' + (i<state.superiority.used?' filled':'');
    d.dataset.i=i;
    d.addEventListener('click', ()=>{
      state.superiority.used = state.superiority.used===i+1 ? i : i+1;
      renderClass(); scheduleSave();
    });
    dotsWrap.appendChild(d);
  }

  const progWrap=document.getElementById('progression-list');
  progWrap.innerHTML='';
  if(state.progression.length===0){
    progWrap.innerHTML='<div class="prog-item">No features unlocked yet.</div>';
  } else {
    state.progression.forEach((p,i)=>{
      const div=document.createElement('div');
      div.className='prog-item';
      div.innerHTML=`
        <span class="prog-lv">Lv ${p.level}</span>
        <span class="prog-text" data-i="${i}" contenteditable="true">${escapeHtml(p.text)}</span>
        <button class="prog-del" data-i="${i}">×</button>
      `;
      progWrap.appendChild(div);
    });
    progWrap.querySelectorAll('.prog-text').forEach(el=>{
      el.addEventListener('input', ()=>{
        state.progression[el.dataset.i].text = el.innerText;
        scheduleSave();
      });
    });
    progWrap.querySelectorAll('.prog-del').forEach(btn=>{
      btn.addEventListener('click', ()=>{
        state.progression.splice(parseInt(btn.dataset.i),1);
        renderClass(); scheduleSave();
      });
    });
  }

  const futureWrap=document.getElementById('future-progression-list');
  const futureToggle=document.getElementById('future-toggle');
  futureWrap.innerHTML='';
  let hasFuture=false;
  for(let lv=state.level+1; lv<=20; lv++){
    (LEVEL_FEATURES[lv]||[]).forEach(text=>{
      hasFuture=true;
      const div=document.createElement('div');
      div.className='prog-item-future';
      div.innerHTML=`<span class="prog-lv">Lv ${lv}</span><span>${escapeHtml(text)}</span>`;
      futureWrap.appendChild(div);
    });
  }
  if(!hasFuture){
    futureWrap.innerHTML='<div class="prog-item-future">Already at max level.</div>';
  }
  futureToggle.textContent = state.showFutureLevels ? '▼ Hide future levels' : '▶ Show future levels';
  futureWrap.style.display = state.showFutureLevels ? 'block' : 'none';

  document.getElementById('maneuvers-known').textContent = maneuversKnown(state.level) || '—';

  const banner=document.getElementById('levelup-banner');
  if(state.pendingLevelUp){
    banner.style.display='block';
    document.getElementById('lu-range').textContent = `Level ${state.pendingLevelUp.from} → ${state.pendingLevelUp.to}`;
    const ul=document.getElementById('lu-features');
    ul.innerHTML = state.pendingLevelUp.features.map(f=>`<li>${escapeHtml(f)}</li>`).join('') || '<li>No new class features at this level — Ability Score Improvement / feat, or just HP.</li>';
    document.getElementById('lu-hp-amt').textContent = state.pendingLevelUp.hpSuggest;
  } else {
    banner.style.display='none';
  }
}

function renderFeatureBlocks(){
  const wrap=document.getElementById('feature-blocks');
  wrap.innerHTML='';
  state.featureBlocks.forEach((fb,i)=>{
    const restType=fb.restType||'none';
    const locked=fb.restLocked!==false; // default true — only explicit false shows the picker
    const used=!!fb.used;
    const div=document.createElement('div');
    div.className='feature-card' + (used?' used':'');

    let restRowHtml;
    if(!locked){
      restRowHtml = `
      <div class="fc-rest-row">
        <select class="fc-rest-select" data-i="${i}">
          <option value="none">No rest tracking</option>
          <option value="short">Recharges: Short Rest</option>
          <option value="long">Recharges: Long Rest</option>
          <option value="both">Recharges: Short or Long Rest</option>
        </select>
      </div>`;
    } else if(restType==='none'){
      restRowHtml = `<div class="fc-rest-row fc-rest-row-quiet"><span class="fc-rest-add-link" data-i="${i}">+ track rest use</span></div>`;
    } else {
      const label = restType==='short' ? '⟳ Short Rest' : restType==='long' ? '⟳ Long Rest' : '⟳ Short or Long Rest';
      restRowHtml = `
      <div class="fc-rest-row">
        <span class="fc-rest-locked">${label} <span class="fc-rest-change" data-i="${i}">change</span></span>
        <label class="fc-used-label"><input type="checkbox" class="fc-used-check" data-i="${i}" ${used?'checked':''}> Used</label>
      </div>`;
    }

    div.innerHTML=`
      <div class="fc-top">
        <span class="fc-handle" title="Drag to reorder">⠿</span>
        <input class="fc-name" data-i="${i}" data-f="name" value="${escapeHtml(fb.name)}" placeholder="Feature name">
        <input class="fc-tag" data-i="${i}" data-f="tag" value="${escapeHtml(fb.tag||'')}" placeholder="Tag">
        <button class="fc-del" data-i="${i}">×</button>
      </div>
      <div class="fc-detail" data-i="${i}" data-f="detail" contenteditable="true" data-placeholder="What it does...">${escapeHtml(fb.detail||'')}</div>
      ${restRowHtml}
    `;
    wrap.appendChild(div);
  });
  wrap.querySelectorAll('.fc-name, .fc-tag').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      state.featureBlocks[inp.dataset.i][inp.dataset.f]=inp.value;
      scheduleSave();
    });
  });
  wrap.querySelectorAll('.fc-detail').forEach(el=>{
    el.addEventListener('input', ()=>{
      state.featureBlocks[el.dataset.i][el.dataset.f]=el.innerText;
      scheduleSave();
    });
  });
  wrap.querySelectorAll('.fc-rest-select').forEach(sel=>{
    sel.addEventListener('change', ()=>{
      const fb=state.featureBlocks[sel.dataset.i];
      fb.restType = sel.value;
      fb.restLocked = true; // choosing anything (including "none") locks it
      if(sel.value==='none') fb.used=false;
      renderFeatureBlocks(); scheduleSave();
    });
  });
  wrap.querySelectorAll('.fc-rest-add-link').forEach(link=>{
    link.addEventListener('click', ()=>{
      state.featureBlocks[link.dataset.i].restLocked=false;
      renderFeatureBlocks();
    });
  });
  wrap.querySelectorAll('.fc-rest-change').forEach(link=>{
    link.addEventListener('click', ()=>{
      state.featureBlocks[link.dataset.i].restLocked=false;
      renderFeatureBlocks();
    });
  });
  wrap.querySelectorAll('.fc-used-check').forEach(chk=>{
    chk.addEventListener('change', ()=>{
      state.featureBlocks[chk.dataset.i].used = chk.checked;
      renderFeatureBlocks(); scheduleSave();
    });
  });
  wrap.querySelectorAll('.fc-del').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      state.featureBlocks.splice(parseInt(btn.dataset.i),1);
      renderFeatureBlocks(); scheduleSave();
    });
  });
  wrap.querySelectorAll('.fc-handle').forEach(handle=>{
    handle.addEventListener('pointerdown', onFeatureDragStart);
  });
}

function onFeatureDragStart(e){
  e.preventDefault();
  const wrap=document.getElementById('feature-blocks');
  const card=e.currentTarget.closest('.feature-card');
  const cards=Array.from(wrap.children);
  const startIndex=cards.indexOf(card);
  const rect=card.getBoundingClientRect();
  const grabOffsetY=e.clientY-rect.top;

  const placeholder=document.createElement('div');
  placeholder.className='fc-placeholder';
  placeholder.style.height=rect.height+'px';
  wrap.insertBefore(placeholder, card);

  card.style.position='fixed';
  card.style.top=rect.top+'px';
  card.style.left=rect.left+'px';
  card.style.width=rect.width+'px';
  card.style.zIndex=1000;
  card.classList.add('dragging');
  document.body.style.userSelect='none';

  function onMove(ev){
    card.style.top=(ev.clientY-grabOffsetY)+'px';
    const pointerY=ev.clientY;
    const siblings=Array.from(wrap.children).filter(c=>c!==card && c!==placeholder);
    let placed=false;
    for(const sib of siblings){
      const r=sib.getBoundingClientRect();
      if(pointerY < r.top + r.height/2){
        wrap.insertBefore(placeholder, sib);
        placed=true;
        break;
      }
    }
    if(!placed) wrap.appendChild(placeholder);
  }
  function onUp(){
    document.removeEventListener('pointermove', onMove);
    document.removeEventListener('pointerup', onUp);
    const finalSiblings=Array.from(wrap.children).filter(c=>c!==card);
    const newIndex=finalSiblings.indexOf(placeholder);
    placeholder.remove();
    card.style.position=''; card.style.top=''; card.style.left=''; card.style.width=''; card.style.zIndex='';
    card.classList.remove('dragging');
    document.body.style.userSelect='';

    const moved=state.featureBlocks.splice(startIndex,1)[0];
    state.featureBlocks.splice(newIndex,0,moved);
    renderFeatureBlocks();
    scheduleSave();
  }
  document.addEventListener('pointermove', onMove);
  document.addEventListener('pointerup', onUp, {once:true});
}

function renderNotes(){
  document.getElementById('f-notes').value=state.notes||'';
}

function escapeHtml(s){
  return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function renderAll(){
  renderCore(); renderAbilities(); renderSaves(); renderSkills(); renderClass(); renderFeatureBlocks(); renderAttacks(); renderItems(); renderNotes();
}

function checkLevelUp(newLevel){
  const from=state.syncedLevel;
  if(newLevel<=from){
    // leveling down or unchanged — just resync silently, no banner
    state.syncedLevel=newLevel;
    state.progression = state.progression.filter(p=>p.level<=newLevel);
    return;
  }
  const newFeatures=[];
  for(let lv=from+1; lv<=newLevel; lv++){
    (LEVEL_FEATURES[lv]||[]).forEach(t=>{
      state.progression.push({level:lv, text:t});
      newFeatures.push(`Lv${lv}: ${t}`);
    });
  }
  const conMod=mod(state.abilities.CON);
  const hpSuggest=(newLevel-from) * (6+conMod);
  state.pendingLevelUp = { from, to:newLevel, features:newFeatures, hpSuggest };
  state.syncedLevel=newLevel;
}

function wireCoreInputs(){
  document.getElementById('f-name').addEventListener('input', e=>{ state.name=e.target.value; scheduleSave(); });
  document.getElementById('f-race').addEventListener('input', e=>{ state.race=e.target.value; scheduleSave(); });
  document.getElementById('f-class').addEventListener('input', e=>{ state.classLabel=e.target.value; scheduleSave(); });
  document.getElementById('f-bg').addEventListener('input', e=>{ state.background=e.target.value; scheduleSave(); });
  const levelInput = document.getElementById('f-level');
  levelInput.addEventListener('change', e=>{
    const newLevel=Math.max(1, Math.min(20, parseInt(e.target.value)||1));
    state.level=newLevel;
    checkLevelUp(newLevel);
    renderCore(); renderSaves(); renderSkills(); renderClass(); scheduleSave();
  });
  document.getElementById('f-ac').addEventListener('input', e=>{ state.ac=parseInt(e.target.value)||0; scheduleSave(); });
  document.getElementById('f-speed').addEventListener('input', e=>{ state.speed=parseInt(e.target.value)||0; scheduleSave(); });

  document.getElementById('f-hpcur').addEventListener('input', e=>{
    state.hp.cur=parseInt(e.target.value)||0; renderCore(); scheduleSave();
  });
  document.getElementById('f-hpmax').addEventListener('input', e=>{
    state.hp.max=parseInt(e.target.value)||0; renderCore(); scheduleSave();
  });
  document.getElementById('f-hptmp').addEventListener('input', e=>{
    state.hp.tmp=parseInt(e.target.value)||0; scheduleSave();
  });

  document.querySelectorAll('.hp-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const d=parseInt(btn.dataset.d);
      if(d<0 && state.hp.tmp>0){
        const absorb=Math.min(state.hp.tmp, -d);
        state.hp.tmp-=absorb;
        const remaining=d+absorb;
        state.hp.cur=Math.max(0, state.hp.cur+remaining);
      } else {
        state.hp.cur=Math.max(0, Math.min(state.hp.max, state.hp.cur+d));
      }
      renderCore(); scheduleSave();
    });
  });

  document.getElementById('insp-dot').addEventListener('click', ()=>{
    state.inspiration=!state.inspiration; renderCore(); scheduleSave();
  });

  document.querySelectorAll('.ds-dot.success').forEach(dot=>{
    dot.addEventListener('click', ()=>{
      const i=parseInt(dot.dataset.i);
      state.deathSaves.success = state.deathSaves.success===i+1 ? i : i+1;
      renderCore(); scheduleSave();
    });
  });
  document.querySelectorAll('.ds-dot.fail').forEach(dot=>{
    dot.addEventListener('click', ()=>{
      const i=parseInt(dot.dataset.i);
      state.deathSaves.fail = state.deathSaves.fail===i+1 ? i : i+1;
      renderCore(); scheduleSave();
    });
  });

  document.getElementById('add-attack').addEventListener('click', ()=>{
    state.attacks.push({name:'New Attack', bonus:'+0', dmg:''});
    renderAttacks(); scheduleSave();
  });
  ['cp','sp','ep','gp','pp'].forEach(k=>{
    document.getElementById('cur-'+k).addEventListener('input', e=>{
      if(!state.currency) state.currency={cp:0,sp:0,ep:0,gp:0,pp:0};
      state.currency[k]=parseInt(e.target.value)||0;
      scheduleSave();
    });
  });
  document.getElementById('add-item').addEventListener('click', ()=>{
    state.inventory.push({name:'New Item', qty:1, notes:''});
    renderItems(); scheduleSave();
  });

  document.getElementById('su-reset').addEventListener('click', ()=>{
    state.superiority.used=0; renderClass(); scheduleSave();
  });

  function takeRest(kind){
    state.featureBlocks.forEach(fb=>{
      if(kind==='long' && (fb.restType==='short'||fb.restType==='long'||fb.restType==='both')) fb.used=false;
      if(kind==='short' && (fb.restType==='short'||fb.restType==='both')) fb.used=false;
    });
    state.superiority.used=0;
    renderFeatureBlocks(); renderClass(); scheduleSave();
  }
  document.getElementById('rest-short').addEventListener('click', ()=>takeRest('short'));
  document.getElementById('rest-long').addEventListener('click', ()=>takeRest('long'));

  document.getElementById('future-toggle').addEventListener('click', ()=>{
    state.showFutureLevels = !state.showFutureLevels;
    renderClass(); scheduleSave();
  });

  document.getElementById('lu-apply-hp').addEventListener('click', ()=>{
    if(!state.pendingLevelUp) return;
    state.hp.max += state.pendingLevelUp.hpSuggest;
    state.hp.cur += state.pendingLevelUp.hpSuggest;
    state.pendingLevelUp=null;
    renderCore(); renderClass(); scheduleSave();
  });
  document.getElementById('lu-dismiss').addEventListener('click', ()=>{
    state.pendingLevelUp=null;
    renderClass(); scheduleSave();
  });

  document.getElementById('add-feature').addEventListener('click', ()=>{
    state.featureBlocks.push({name:'New Feature', tag:'', detail:'', restType:'none', restLocked:false, used:false});
    renderFeatureBlocks(); scheduleSave();
  });

  document.getElementById('f-notes').addEventListener('input', e=>{ state.notes=e.target.value; scheduleSave(); });

  document.querySelectorAll('.tab').forEach(tab=>{
    tab.addEventListener('click', ()=>{
      document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById('panel-'+tab.dataset.tab).classList.add('active');
    });
  });

  document.getElementById('export-btn').addEventListener('click', ()=>{
    const blob = new Blob([JSON.stringify(state, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const safeName = (state.name||'character').replace(/[^a-z0-9]+/gi,'_').toLowerCase();
    a.href = url;
    a.download = `${safeName}_backup_${new Date().toISOString().slice(0,10)}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });

  document.getElementById('import-btn').addEventListener('click', ()=>{
    document.getElementById('import-file').click();
  });
  document.getElementById('import-file').addEventListener('change', (e)=>{
    const file = e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = async (ev)=>{
      try{
        const loaded = JSON.parse(ev.target.result);
        if(!confirm(`Load "${loaded.name || 'this character'}" and replace everything currently on the sheet?`)) return;
        state = loaded;
        if(state.syncedLevel===undefined) state.syncedLevel = state.level;
        if(!state.progression) state.progression = [];
        if(!state.superiority) state.superiority = {used:0};
        if(!state.currency) state.currency = {cp:0,sp:0,ep:0,gp:0,pp:0};
        if(!state.featureBlocks) state.featureBlocks = [];
        if(!state.skillExpertise) state.skillExpertise = [];
        if(state.pendingLevelUp===undefined) state.pendingLevelUp = null;
        renderAll();
        attemptSave();
      }catch(err){
        alert('That file could not be read as a character backup.');
      }
    };
    reader.readAsText(file);
    e.target.value='';
  });

  document.getElementById('reset-link').addEventListener('click', async ()=>{
    if(!confirm('Reset this sheet to a blank template? This clears the current character.')) return;
    state = {
      name:'New Character', race:'', classLabel:'', background:'', level:1,
      ac:10, speed:30, inspiration:false,
      abilities:{STR:10,DEX:10,CON:10,INT:10,WIS:10,CHA:10},
      hp:{max:10,cur:10,tmp:0},
      deathSaves:{success:0,fail:0},
      saveProfs:[], skillProfs:[], skillExpertise:[],
      attacks:[], inventory:[], features:'', notes:'',
      currency:{cp:0,sp:0,ep:0,gp:0,pp:0}, featureBlocks:[],
      syncedLevel:1, progression: (LEVEL_FEATURES[1]||[]).map(t=>({level:1,text:t})),
      superiority:{used:0}, showFutureLevels:false, pendingLevelUp:null
    };
    renderAll();
    attemptSave();
  });
}

(async function init(){
  await loadState();
  renderAll();
  wireCoreInputs();
})();
</script>
</body>
</html>
