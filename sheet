  wrap.querySelectorAll('input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      state.attacks[inp.dataset.i][inp.dataset.f]=inp.value;
      scheduleSave();
    });
  });
  wrap.querySelectorAll('.li-del').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      state.attacks.splice(parseInt(btn.dataset.i),1);
      renderAttacks(); scheduleSave();
    });
  });
}

