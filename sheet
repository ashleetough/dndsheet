<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Field Record — Trent Yubin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Archivo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #16180f;
    --bg-2: #1d2016;
    --card: #23261c;
    --card-2: #2a2e21;
    --line: #3a3e2e;
    --ink: #e9e3d0;
    --ink-dim: #9a9d84;
    --brass: #c19a56;
    --brass-dim: #8a713f;
    --olive: #6f7a4a;
    --red: #b8493b;
    --green: #6d9057;
    --amber: #c1954a;
    --radius: 3px;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color: transparent;}
  html,body{margin:0;padding:0;background:var(--bg);color:var(--ink);}
  body{
    font-family:'Archivo',sans-serif;
    padding-bottom:40px;
    background-image:
      radial-gradient(circle at 15% 8%, rgba(193,154,86,0.05), transparent 40%),
      radial-gradient(circle at 90% 90%, rgba(111,122,74,0.06), transparent 45%);
  }
  .wrap{max-width:520px;margin:0 auto;padding:14px 14px 0;}

  /* ---- header / stamp ---- */
  .letterhead{
    display:flex;justify-content:space-between;align-items:flex-start;
    padding:10px 2px 12px;border-bottom:1px dashed var(--line);
    margin-bottom:14px;
  }
  .lh-left{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0;}
  .eyebrow{
    font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;
    color:var(--brass-dim);text-transform:uppercase;
  }
  .name-input{
    font-family:'Special Elite',monospace;font-size:26px;color:var(--ink);
    background:transparent;border:none;outline:none;width:100%;padding:2px 0;
    border-bottom:1px solid transparent;
  }
  .name-input:focus{border-bottom:1px solid var(--brass);}
  .subline{display:flex;flex-wrap:wrap;gap:6px;margin-top:4px;}
  .chip-input{
    font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-dim);
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:4px 7px;outline:none;min-width:0;
  }
  .chip-input:focus{border-color:var(--brass-dim);color:var(--ink);}
  .chip-input.small{width:44px;text-align:center;}

  .stamp{
    flex-shrink:0;width:70px;height:70px;border-radius:50%;
    border:2px solid var(--stamp-color, var(--green));
    display:flex;align-items:center;justify-content:center;text-align:center;
    transform:rotate(-8deg);
    font-family:'Special Elite',monospace;color:var(--stamp-color, var(--green));
    font-size:9px;letter-spacing:.05em;line-height:1.2;text-transform:uppercase;
    box-shadow:0 0 0 1px var(--stamp-color, var(--green)) inset;
    opacity:.85;
  }

  /* ---- core stat bar ---- */
  .core-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:12px;}
  .core-card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:8px 6px;text-align:center;
  }
  .core-label{font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;color:var(--ink-dim);text-transform:uppercase;}
  .core-value{
    font-family:'Special Elite',monospace;font-size:20px;color:var(--brass);
    background:transparent;border:none;outline:none;width:100%;text-align:center;margin-top:2px;
  }

  .hp-block{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:10px 12px;margin-bottom:12px;
  }
  .hp-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;}
  .hp-label{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;color:var(--ink-dim);text-transform:uppercase;}
  .hp-nums{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--ink);display:flex;align-items:center;gap:4px;}
  .hp-nums input{
    width:38px;background:var(--card-2);border:1px solid var(--line);color:var(--ink);
    font-family:'JetBrains Mono',monospace;font-size:13px;text-align:center;border-radius:2px;padding:2px;
  }
  .hp-bar-track{height:9px;background:var(--card-2);border-radius:5px;overflow:hidden;border:1px solid var(--line);}
  .hp-bar-fill{height:100%;background:var(--green);transition:width .25s, background .25s;}
  .hp-btns{display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;}
  .hp-btn{
    flex:1;min-width:40px;font-family:'JetBrains Mono',monospace;font-size:12px;
    background:var(--card-2);border:1px solid var(--line);color:var(--ink);
    padding:6px 0;border-radius:2px;cursor:pointer;
  }
  .hp-btn.dmg{color:var(--red);}
  .hp-btn.heal{color:var(--green);}
  .hp-btn:active{background:var(--line);}
  .tmp-row{display:flex;align-items:center;gap:6px;margin-top:8px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-dim);}
  .tmp-row input{width:36px;background:var(--card-2);border:1px solid var(--line);color:var(--ink);text-align:center;border-radius:2px;padding:2px;}

  .death-saves{display:flex;justify-content:space-between;align-items:center;margin-top:10px;padding-top:8px;border-top:1px dashed var(--line);}
  .ds-group{display:flex;align-items:center;gap:6px;}
  .ds-label{font-family:'JetBrains Mono',monospace;font-size:9px;color:var(--ink-dim);letter-spacing:.08em;text-transform:uppercase;}
  .ds-dot{width:13px;height:13px;border-radius:50%;border:1.5px solid var(--line);cursor:pointer;}
  .ds-dot.success.filled{background:var(--green);border-color:var(--green);}
  .ds-dot.fail.filled{background:var(--red);border-color:var(--red);}

  /* ---- top trackers: inspiration + superiority dice ---- */
  .tracker-row{display:flex;gap:8px;margin-bottom:12px;align-items:stretch;}
  .tracker-block{
    display:flex;align-items:center;justify-content:space-between;gap:8px;flex:0 0 auto;
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:8px 12px;
  }
  .tracker-block-wide{flex:1;flex-direction:column;align-items:stretch;gap:6px;}
  .tracker-block-top{display:flex;align-items:center;justify-content:space-between;gap:8px;}
  .insp-label{font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;color:var(--ink-dim);text-transform:uppercase;}
  .insp-dot{width:20px;height:20px;border-radius:50%;border:2px solid var(--brass-dim);cursor:pointer;flex-shrink:0;}
  .insp-dot.on{background:var(--brass);border-color:var(--brass);box-shadow:0 0 8px rgba(193,154,86,.5);}

  /* ---- tabs ---- */
  .tabs{display:flex;gap:4px;margin-bottom:12px;border-bottom:1px solid var(--line);}
  .tab{
    flex:1;text-align:center;padding:9px 2px;font-family:'JetBrains Mono',monospace;
    font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-dim);
    cursor:pointer;border-bottom:2px solid transparent;
  }
  .tab.active{color:var(--brass);border-bottom-color:var(--brass);}
  .panel{display:none;}
  .panel.active{display:block;}

  /* ---- abilities ---- */
  .ability-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px;}
  .ability-card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:8px 4px;text-align:center;}
  .ability-name{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.1em;color:var(--ink-dim);text-transform:uppercase;}
  .ability-mod{font-family:'Special Elite',monospace;font-size:19px;color:var(--brass);margin:2px 0;}
  .ability-score-input{
    width:34px;background:var(--card-2);border:1px solid var(--line);color:var(--ink);
    font-family:'JetBrains Mono',monospace;font-size:11px;text-align:center;border-radius:2px;padding:2px;
  }

  .section-title{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;color:var(--brass-dim);text-transform:uppercase;margin:16px 2px 6px;}

  .row-line{
    display:flex;align-items:center;gap:8px;padding:6px 4px;border-bottom:1px solid var(--line);
    font-family:'Archivo',sans-serif;font-size:13px;
  }
  .row-line:last-child{border-bottom:none;}
  .prof-box{
    width:15px;height:15px;border:1.5px solid var(--brass-dim);border-radius:50%;flex-shrink:0;cursor:pointer;
  }
  .prof-box.on{background:var(--brass);border-color:var(--brass);}
  .prof-box.expertise{
    background:var(--brass);border-color:var(--brass);
    box-shadow:0 0 0 2px var(--bg), 0 0 0 3.5px var(--brass);
  }
  .row-name{flex:1;color:var(--ink);}
  .row-bonus{font-family:'JetBrains Mono',monospace;color:var(--brass);width:34px;text-align:right;}
  .row-sub{font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-dim);width:30px;}

  .dot-legend{
    display:flex;align-items:center;flex-wrap:wrap;gap:4px;
    font-family:'JetBrains Mono',monospace;font-size:9.5px;color:var(--ink-dim);margin-bottom:8px;
  }
  .dot-legend .prof-box{cursor:default;}

  .passive-box{
    display:flex;justify-content:space-between;align-items:center;
    background:var(--card-2);border:1px solid var(--line);border-radius:var(--radius);
    padding:8px 12px;margin-top:10px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--ink-dim);
  }
  .passive-box b{color:var(--brass);font-size:14px;}

  /* ---- lists (attacks/inventory) ---- */
  .currency-row{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:16px;}
  .cur-cell{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:6px 4px;text-align:center;}
  .cur-cell label{display:block;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.1em;color:var(--ink-dim);text-transform:uppercase;margin-bottom:3px;}
  .cur-cell input{width:100%;background:transparent;border:none;outline:none;color:var(--brass);font-family:'JetBrains Mono',monospace;font-size:14px;text-align:center;}

  .list-item{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:8px 10px;margin-bottom:7px;
  }
  .li-top{display:flex;gap:6px;align-items:center;}
  .li-name{
    flex:1;background:transparent;border:none;outline:none;color:var(--ink);
    font-family:'Archivo',sans-serif;font-weight:600;font-size:13.5px;border-bottom:1px solid transparent;
  }
  .li-name:focus{border-bottom:1px solid var(--brass-dim);}
  .li-del{
    background:none;border:none;color:var(--red);font-size:16px;cursor:pointer;padding:2px 6px;line-height:1;
  }
  .li-sub{display:flex;gap:6px;margin-top:6px;}
  .li-sub input{
    background:var(--card-2);border:1px solid var(--line);color:var(--ink-dim);
    font-family:'JetBrains Mono',monospace;font-size:11px;border-radius:2px;padding:5px 6px;flex:1;min-width:0;
  }
  .li-sub input.qty{flex:0 0 46px;text-align:center;}
  .add-btn{
    width:100%;padding:9px;background:var(--card-2);border:1px dashed var(--brass-dim);
    color:var(--brass-dim);font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.08em;
    text-transform:uppercase;border-radius:var(--radius);cursor:pointer;margin-top:2px;margin-bottom:16px;
  }
  .add-btn:active{background:var(--line);}

  textarea{
    width:100%;background:var(--card);border:1px solid var(--line);color:var(--ink);
    font-family:'Archivo',sans-serif;font-size:13px;line-height:1.5;border-radius:var(--radius);
    padding:10px;resize:vertical;min-height:90px;margin-bottom:14px;outline:none;
  }
  textarea:focus{border-color:var(--brass-dim);}

  .save-flag{
    position:fixed;bottom:14px;left:50%;transform:translateX(-50%) translateY(20px);
    font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;
    color:var(--ink-dim);background:var(--card);border:1px solid var(--line);border-radius:20px;
    padding:5px 14px;opacity:0;transition:opacity .3s, transform .3s;pointer-events:none;
    max-width:88vw;text-align:center;z-index:50;
  }
  .save-flag.show{opacity:1;transform:translateX(-50%) translateY(0);}

  .levelup-banner{
    background:var(--card-2);border:1px solid var(--brass-dim);border-radius:var(--radius);
    padding:12px;margin-bottom:16px;
  }
  .lu-title{font-family:'Special Elite',monospace;font-size:14px;color:var(--brass);margin-bottom:6px;}
  .levelup-banner ul{margin:0 0 10px;padding-left:18px;font-size:12.5px;color:var(--ink);line-height:1.6;}
  .lu-actions{display:flex;gap:8px;}
  .lu-btn{
    flex:1;font-family:'JetBrains Mono',monospace;font-size:11px;padding:7px 0;border-radius:2px;cursor:pointer;
    border:1px solid var(--line);background:var(--card);color:var(--ink);
  }
  .lu-btn.apply{border-color:var(--brass-dim);color:var(--brass);}
  .lu-btn:active{background:var(--line);}

  .su-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
  .su-dots{display:flex;gap:6px;flex-wrap:wrap;flex:1;}
  .su-dot{width:17px;height:17px;border-radius:3px;border:1.5px solid var(--brass-dim);cursor:pointer;transform:rotate(45deg);}
  .su-dot.filled{background:var(--brass);border-color:var(--brass);}

  .feature-card{
    background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
    padding:9px 10px;margin-bottom:8px;
  }
  .feature-card.dragging{
    box-shadow:0 8px 20px rgba(0,0,0,.4);border-color:var(--brass);opacity:.95;
  }
  .fc-placeholder{
    border:1.5px dashed var(--brass-dim);border-radius:var(--radius);margin-bottom:8px;background:rgba(193,154,86,0.06);
  }
  .feature-card.used{opacity:.55;}
  .feature-card.used .fc-name{text-decoration:line-through;text-decoration-color:var(--red);}

  .rest-btn-row{display:flex;gap:8px;margin-bottom:10px;}
  .rest-btn{
    flex:1;padding:8px 0;background:var(--card-2);border:1px solid var(--brass-dim);color:var(--brass);
    font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.05em;border-radius:var(--radius);cursor:pointer;
  }
  .rest-btn:active{background:var(--line);}

  .fc-rest-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px;padding-top:7px;border-top:1px dashed var(--line);flex-wrap:wrap;}
  .fc-rest-row-quiet{border-top:none;padding-top:2px;margin-top:2px;justify-content:flex-start;}
  .fc-rest-select{
    background:var(--card-2);border:1px solid var(--line);color:var(--ink-dim);
    font-family:'JetBrains Mono',monospace;font-size:10px;border-radius:2px;padding:4px 6px;flex:1;min-width:0;
  }
  .fc-rest-locked{
    font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--brass-dim);letter-spacing:.03em;
  }
  .fc-rest-change{
    color:var(--ink-dim);text-decoration:underline;cursor:pointer;margin-left:4px;
  }
  .fc-rest-add-link{
    font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink-dim);opacity:.55;
    text-decoration:underline;cursor:pointer;
  }
  .fc-used-label{
    display:flex;align-items:center;gap:5px;font-family:'JetBrains Mono',monospace;font-size:11px;
    color:var(--ink-dim);flex-shrink:0;cursor:pointer;white-space:nowrap;
  }
  .fc-used-label input{width:15px;height:15px;accent-color:var(--brass);cursor:pointer;}

  .fc-handle{
    order:-1;flex-shrink:0;cursor:grab;color:var(--ink-dim);font-size:16px;line-height:1;
    padding:2px 6px 2px 0;touch-action:none;user-select:none;
  }
  .fc-handle:active{cursor:grabbing;color:var(--brass);}
  .fc-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap;}
  .fc-name{
    flex:1 1 100%;background:transparent;border:none;outline:none;color:var(--ink);
    font-family:'Archivo',sans-serif;font-weight:700;font-size:14px;border-bottom:1px solid transparent;
    order:1;
  }
  .fc-name:focus{border-bottom:1px solid var(--brass-dim);}
  .fc-tag{
    flex:0 1 auto;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:.06em;
    text-transform:uppercase;color:var(--brass);background:var(--card-2);border:1px solid var(--brass-dim);
    border-radius:10px;padding:3px 8px;max-width:70%;text-align:center;order:2;
  }
  .fc-detail{
    width:100%;margin-top:6px;background:transparent;border:none;outline:none;
    color:var(--ink-dim);font-family:'Archivo',sans-serif;font-size:12.5px;line-height:1.5;
    padding:0;white-space:pre-wrap;order:4;
  }
  .fc-detail:empty::before{content:attr(data-placeholder);color:var(--ink-dim);opacity:.6;}
  .fc-del{background:none;border:none;color:var(--red);font-size:15px;cursor:pointer;padding:2px 4px;line-height:1;flex-shrink:0;order:3;margin-left:auto;}

  .maneuver-item{padding:7px 4px;border-bottom:1px solid var(--line);font-size:12px;color:var(--ink-dim);line-height:1.5;}
  .maneuver-item:last-child{border-bottom:none;}
  .maneuver-item b{color:var(--ink);font-family:'Archivo',sans-serif;font-size:13px;}

  .prog-item{
    display:flex;gap:8px;padding:6px 4px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--ink-dim);align-items:flex-start;
  }
  .prog-item:last-child{border-bottom:none;}
  .prog-lv{font-family:'JetBrains Mono',monospace;color:var(--brass-dim);flex-shrink:0;width:34px;padding-top:1px;}
  .prog-text{flex:1;outline:none;line-height:1.5;border-bottom:1px solid transparent;}
  .prog-text:focus{border-bottom:1px solid var(--brass-dim);color:var(--ink);}
  .prog-del{background:none;border:none;color:var(--red);font-size:15px;cursor:pointer;padding:0 4px;line-height:1.4;flex-shrink:0;}

  .future-toggle{
    font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:.05em;color:var(--brass-dim);
    text-decoration:underline;cursor:pointer;margin:10px 2px 4px;
  }
  .prog-item-future{
    display:flex;gap:8px;padding:6px 4px;border-bottom:1px solid var(--line);font-size:12px;
    color:var(--ink-dim);opacity:.55;
  }
  .prog-item-future:last-child{border-bottom:none;}
  .prog-item-future .prog-lv{font-family:'JetBrains Mono',monospace;color:var(--ink-dim);flex-shrink:0;width:34px;}

  .backup-row{display:flex;gap:8px;margin-bottom:8px;}
  .backup-note{font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--ink-dim);line-height:1.5;margin-bottom:16px;}

  .save-flag.save-flag-error{
    color:var(--red);border-color:var(--red);background:var(--card-2);
    text-transform:none;letter-spacing:normal;font-size:11px;white-space:normal;
    border-radius:10px;pointer-events:auto;
  }

  .reset-link{
    text-align:center;margin:6px 0 30px;font-family:'JetBrains Mono',monospace;font-size:10px;
    color:var(--ink-dim);text-decoration:underline;cursor:pointer;letter-spacing:.05em;
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="letterhead">
    <div class="lh-left">
      <div class="eyebrow">Field Record</div>
      <input id="f-name" class="name-input" value="Trent Yubin">
      <div class="subline">
        <input id="f-race" class="chip-input" value="Human">
        <input id="f-class" class="chip-input" value="Fighter (Battle Master)">
        <input id="f-bg" class="chip-input" value="Courier Brigade">
        <span class="chip-input" style="display:flex;align-items:center;gap:4px;">LV <input id="f-level" class="chip-input small" style="border:none;background:transparent;padding:0;" type="number" value="3" min="1" max="20"></span>
      </div>
    </div>
    <div id="stamp" class="stamp">ACTIVE<br>DUTY</div>
  </div>

  <div class="core-row">
    <div class="core-card">
      <div class="core-label">AC</div>
      <input id="f-ac" class="core-value" type="number" value="15">
    </div>
    <div class="core-card">
      <div class="core-label">Speed</div>
      <input id="f-speed" class="core-value" type="number" value="30">
    </div>
    <div class="core-card">
      <div class="core-label">Init</div>
      <div class="core-value" id="f-init">+2</div>
    </div>
    <div class="core-card">
      <div class="core-label">Prof</div>
      <div class="core-value" id="f-prof">+2</div>
    </div>
  </div>

  <div class="hp-block">
    <div class="hp-top">
      <div class="hp-label">Hit Points</div>
      <div class="hp-nums"><input id="f-hpcur" type="number" value="22"> / <input id="f-hpmax" type="number" value="22"></div>
    </div>
    <div class="hp-bar-track"><div class="hp-bar-fill" id="hp-bar" style="width:100%"></div></div>
    <div class="hp-btns">
      <button class="hp-btn dmg" data-d="-5">-5</button>
      <button class="hp-btn dmg" data-d="-1">-1</button>
