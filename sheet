let state = null;
const STORAGE_KEY = 'trent_yubin_character_sheet';

function mod(score){ return Math.floor((score-10)/2); }
function fmt(n){ return (n>=0?'+':'') + n; }
function profBonus(level){ return Math.floor((level-1)/4) + 2; }

async function loadState(){
  try{
    const res = await window.storage.get(STORAGE_KEY, false);
    if(res && res.value){
      state = JSON.parse(res.value);
      if(state.syncedLevel===undefined) state.syncedLevel = state.level;
      if(!state.progression) state.progression = [];
      if(!state.superiority) state.superiority = {used:0};
      if(!state.currency) state.currency = {cp:0,sp:0,ep:0,gp:0,pp:0};
      if(!state.featureBlocks) state.featureBlocks = [];
      if(!state.skillExpertise) state.skillExpertise = [];
      if(state.showFutureLevels===undefined) state.showFutureLevels = false;
      if(state.pendingLevelUp===undefined) state.pendingLevelUp = null;
      return;
    }
  }catch(e){ /* key not found or storage unavailable */ }
  state = JSON.parse(JSON.stringify(DEFAULT_STATE));
}

let saveTimer=null;
let saveRetries=0;
let backgroundRetryTimer=null;
function scheduleSave(){
  clearTimeout(saveTimer);
  clearTimeout(backgroundRetryTimer);
  saveTimer=setTimeout(()=>attemptSave(), 400);
}
async function attemptSave(){
  try{
    const result = await window.storage.set(STORAGE_KEY, JSON.stringify(state), false);
    if(!result) throw new Error('Storage set returned no result');
    saveRetries=0;
    flashSaved(true);
  }catch(e){
    console.error('Save failed', e);
    saveRetries++;
    if(saveRetries>=3){
      flashSaved(false); // sticky error banner, keeps retrying quietly underneath
    }
    const delay = Math.min(30000, 1000 * Math.pow(2, Math.min(saveRetries,5)));
    clearTimeout(backgroundRetryTimer);
    backgroundRetryTimer=setTimeout(()=>attemptSave(), delay);
  }
}
function flashSaved(success){
  const el=document.getElementById('save-flag');
  if(success){
    el.textContent='Saved';
    el.classList.remove('save-flag-error');
    el.classList.add('show');
    clearTimeout(flashSaved._t);
    flashSaved._t=setTimeout(()=>el.classList.remove('show'), 900);
  } else {
    el.innerHTML = 'Save failed, retrying… <span id="retry-now" style="text-decoration:underline;cursor:pointer;">Retry now</span> · use Backup below';
    el.classList.add('save-flag-error', 'show');
    clearTimeout(flashSaved._t); // sticky — stays until a save succeeds
    const retryBtn=document.getElementById('retry-now');
    if(retryBtn) retryBtn.addEventListener('click', ()=>{ clearTimeout(backgroundRetryTimer); attemptSave(); });
  }
}

function updateStamp(){
  const pct = state.hp.max>0 ? state.hp.cur/state.hp.max : 0;
  const stamp=document.getElementById('stamp');
  let color, text;
  if(state.hp.cur<=0){ color='var(--red)'; text='DOWN'; }
  else if(pct<=0.25){ color='var(--red)'; text='CRITICAL'; }
  else if(pct<=0.5){ color='var(--amber)'; text='WOUNDED'; }
  else { color='var(--green)'; text='ACTIVE<br>DUTY'; }
  stamp.style.setProperty('--stamp-color', color);
  stamp.innerHTML=text;
}

function renderCore(){
  document.getElementById('f-name').value=state.name;
  document.getElementById('f-race').value=state.race;
  document.getElementById('f-class').value=state.classLabel;
  document.getElementById('f-bg').value=state.background;
  const lvlEl=document.getElementById('f-level');
  if(document.activeElement!==lvlEl) lvlEl.value=state.level;
  document.getElementById('f-ac').value=state.ac;
  document.getElementById('f-speed').value=state.speed;
  document.getElementById('f-init').textContent=fmt(mod(state.abilities.DEX));
  document.getElementById('f-prof').textContent=fmt(profBonus(state.level));
  document.getElementById('f-hpcur').value=state.hp.cur;
  document.getElementById('f-hpmax').value=state.hp.max;
  document.getElementById('f-hptmp').value=state.hp.tmp;
  const pct=Math.max(0,Math.min(1, state.hp.max>0?state.hp.cur/state.hp.max:0));
  const bar=document.getElementById('hp-bar');
  bar.style.width=(pct*100)+'%';
  bar.style.background = pct<=0.25?'var(--red)':pct<=0.5?'var(--amber)':'var(--green)';
  document.getElementById('insp-dot').classList.toggle('on', !!state.inspiration);
  document.querySelectorAll('.ds-dot.success').forEach((d,i)=>d.classList.toggle('filled', i<state.deathSaves.success));
  document.querySelectorAll('.ds-dot.fail').forEach((d,i)=>d.classList.toggle('filled', i<state.deathSaves.fail));
  updateStamp();
}

function renderAbilities(){
  const grid=document.getElementById('ability-grid');
  grid.innerHTML='';
  ABILS.forEach(a=>{
    const div=document.createElement('div');
    div.className='ability-card';
    div.innerHTML=`
      <div class="ability-name">${a}</div>
      <div class="ability-mod" id="mod-${a}">${fmt(mod(state.abilities[a]))}</div>
      <input class="ability-score-input" data-a="${a}" type="number" value="${state.abilities[a]}">
    `;
    grid.appendChild(div);
  });
  grid.querySelectorAll('.ability-score-input').forEach(inp=>{
    inp.addEventListener('input', ()=>{
      const a=inp.dataset.a;
      state.abilities[a]=parseInt(inp.value)||0;
      document.getElementById(`mod-${a}`).textContent=fmt(mod(state.abilities[a]));
      renderCore(); renderSaves(); renderSkills();
      scheduleSave();
    });
  });
}

function renderSaves(){
  const wrap=document.getElementById('save-list');
  wrap.innerHTML='';
  const pb=profBonus(state.level);
  ABILS.forEach(a=>{
    const isProf=state.saveProfs.includes(a);
    const bonus=mod(state.abilities[a]) + (isProf?pb:0);
    const row=document.createElement('div');
    row.className='row-line';
    row.innerHTML=`
      <div class="prof-box ${isProf?'on':''}" data-a="${a}"></div>
      <div class="row-name">${a} Save</div>
      <div class="row-bonus">${fmt(bonus)}</div>
    `;
    row.querySelector('.prof-box').addEventListener('click', function(){
      const idx=state.saveProfs.indexOf(a);
      if(idx>=0) state.saveProfs.splice(idx,1); else state.saveProfs.push(a);
      renderSaves(); scheduleSave();
    });
    wrap.appendChild(row);
  });
}

function renderSkills(){
  const wrap=document.getElementById('skill-list');
  wrap.innerHTML='';
  const pb=profBonus(state.level);
  SKILLS.forEach(([name, abil])=>{
    const isProf=state.skillProfs.includes(name);
    const isExpert=state.skillExpertise.includes(name);
    const profMult = isExpert ? 2 : (isProf ? 1 : 0);
    const bonus=mod(state.abilities[abil]) + pb*profMult;
    const dotClass = isExpert ? 'expertise' : (isProf ? 'on' : '');
    const row=document.createElement('div');
    row.className='row-line';
    row.innerHTML=`
      <div class="prof-box ${dotClass}" data-n="${name}" title="Tap: none → proficient → expertise"></div>
      <div class="row-name">${name}</div>
      <div class="row-sub">${abil}</div>
      <div class="row-bonus">${fmt(bonus)}</div>
    `;
    row.querySelector('.prof-box').addEventListener('click', function(){
      const profIdx=state.skillProfs.indexOf(name);
      const expIdx=state.skillExpertise.indexOf(name);
      if(expIdx>=0){
        // expertise -> none
        state.skillExpertise.splice(expIdx,1);
        state.skillProfs.splice(profIdx,1);
      } else if(profIdx>=0){
        // proficient -> expertise
        state.skillExpertise.push(name);
      } else {
        // none -> proficient
        state.skillProfs.push(name);
      }
      renderSkills(); scheduleSave();
    });
    wrap.appendChild(row);
  });
  const percProfMult = state.skillExpertise.includes('Perception') ? 2 : (state.skillProfs.includes('Perception') ? 1 : 0);
  const percBonus = mod(state.abilities.WIS) + pb*percProfMult;
  document.getElementById('passive-perc').textContent = 10+percBonus;
}

function renderAttacks(){
  const wrap=document.getElementById('attack-list');
